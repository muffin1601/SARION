// Sarion — Agency CRM + Client Portal
// 8 MVP entities per docs/MVP-PRD.md §7

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // transaction pooler (pgbouncer) — app runtime
  directUrl = env("DIRECT_URL") // session pooler — migrations & introspection
}

enum Role {
  owner
  member
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  COMPLETED
  ON_HOLD
}

enum InvoiceStatus {
  paid
  unpaid
  overdue
}

enum PlanTier {
  free
  starter
  growth
  agency
}

enum BillingInterval {
  monthly
  yearly
}

enum FeedbackType {
  feature_request
  bug_report
  general
}

enum FeedbackStatus {
  open
  in_review
  planned
  completed
  declined
}

// Idempotency ledger for Lemon Squeezy webhooks. Each event is processed at
// most once; a duplicate delivery is short-circuited on the unique eventId.
model LemonWebhookEvent {
  id        String   @id @default(cuid())
  eventId   String   @unique
  type      String
  createdAt DateTime @default(now())
}

model Agency {
  id                  String          @id @default(cuid())
  name                String
  logoUrl             String?
  // --- Billing / plan (see src/config/plans.ts for the source of truth) ---
  planTier            PlanTier        @default(free)
  billingInterval     BillingInterval @default(monthly)
  // Launch-cohort flag. Retained for lifetime perks / badge; Lemon Squeezy has
  // no per-customer locked price so it no longer affects which variant is sold.
  foundingMember      Boolean         @default(false)
  // 14-day no-card trial. Null once the agency has converted to a paid plan.
  trialEndsAt         DateTime?
  // --- Lemon Squeezy billing identifiers ---
  lemonCustomerId     String?
  lemonOrderId        String?
  lemonSubscriptionId String?
  // Subscription lifecycle (normalized): trialing | active | past_due | canceled | unpaid | incomplete
  subscriptionStatus  String          @default("trialing")
  // Next invoice sequence number to assign (per-agency). Atomically incremented
  // during invoice creation — see src/server/services/invoice-number.ts.
  invoiceSequence     Int             @default(1)
  // Whether the starter sample workspace has been seeded (F8 onboarding).
  seeded              Boolean         @default(false)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @default(now()) @updatedAt

  users              User[]
  clients            Client[]
  projects           Project[]
  invoices           Invoice[]
  tasks              Task[]
  invoiceItems       InvoiceItem[]
  comments           Comment[]
  activities         Activity[]
  teamInvites        TeamInvite[]
  portalComments     PortalComment[]
  feedback           Feedback[]
  automations        Automation[]
  costs              Cost[]
  proposals          Proposal[]
  proposalTemplates  ProposalTemplate[]
  proposalActivities ProposalActivity[]
  subscriptions      Subscription[]
  recurringInvoices  RecurringInvoice[]
  timeEntries        TimeEntry[]
  timerSessions      TimerSession[]
  proposalItems      ProposalItem[]
}

// In-app feedback from authenticated users — feature requests, bug reports, and
// general feedback. Reviewed by agency owners at /settings/feedback.
model Feedback {
  id          String         @id @default(cuid())
  agencyId    String
  userId      String
  type        FeedbackType   @default(general)
  title       String
  description String
  status      FeedbackStatus @default(open)
  createdAt   DateTime       @default(now())

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([agencyId, createdAt])
  @@index([status])
}

model User {
  id                  String   @id @default(cuid())
  agencyId            String
  name                String
  email               String   @unique
  emailVerified       Boolean  @default(false)
  image               String?
  role                Role     @default(owner)
  // Per-user dashboard layout: { hidden: string[], collapsed: string[], order:
  // string[], dismissedNotificationIds: string[] }. See src/server/actions/dashboard-prefs.ts.
  dashboardPrefs      Json?
  // Resource Management — manual, optional. No payroll/HR integration.
  weeklyCapacityHours Float?   @default(40)
  hourlyCostRate      Decimal? @db.Decimal(10, 2)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  agency               Agency         @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  sessions             Session[]
  accounts             Account[]
  feedback             Feedback[]
  activities           Activity[]
  automations          Automation[]
  assignedTasks        Task[]
  costs                Cost[]
  proposalsCreated     Proposal[]
  subscriptionsCreated Subscription[]
  timeEntries          TimeEntry[]
  timerSessions        TimerSession[]

  @@index([agencyId])
}

// --- Better Auth tables (email/password) ---

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Client {
  id          String    @id @default(cuid())
  agencyId    String
  name        String
  company     String?
  email       String?
  phone       String?
  notes       String?
  portalToken String    @unique @default(cuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  deletedAt   DateTime?

  agency        Agency         @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  projects      Project[]
  invoices      Invoice[]
  comments      Comment[]
  activities    Activity[]
  costs         Cost[]
  proposals     Proposal[]
  subscriptions Subscription[]
  timeEntries   TimeEntry[]

  @@index([agencyId])
}

// Append-only audit trail. Most events are client-scoped, but agency-level
// events (e.g. team member invited) have a null clientId. Doubles as the
// backing store for the Unified Client Timeline (see /clients/[id]) and is
// designed to back future ERP modules (HR, support tickets, inventory, etc.)
// via new nullable FKs + ActivityType values, with no schema redesign.
model Activity {
  id          String   @id @default(cuid())
  agencyId    String
  clientId    String?
  projectId   String?
  invoiceId   String?
  userId      String?
  type        String
  // Short headline for timeline UIs; falls back to `type` when null.
  title       String?
  description String
  // Structured payload (amount, filename, meeting time, etc.) for richer
  // timeline rendering without further schema changes.
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  agency  Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  client  Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([agencyId, createdAt])
  @@index([clientId, createdAt])
  @@index([clientId, type, createdAt])
  @@index([projectId, createdAt])
}

model Project {
  id             String        @id @default(cuid())
  agencyId       String
  clientId       String
  name           String
  description    String?
  status         ProjectStatus @default(PLANNED)
  startDate      DateTime?
  dueDate        DateTime?
  // Manual budget entered once by the owner. Actual cost/hours are derived
  // from linked Cost rows and TimeEntry rows (see src/server/data/finance.ts,
  // src/server/data/time.ts) — this stays the single manually-entered budget.
  estimatedCost  Decimal?      @db.Decimal(10, 2)
  estimatedHours Float?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now()) @updatedAt
  deletedAt      DateTime?

  agency         Agency          @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  client         Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tasks          Task[]
  comments       Comment[]
  activities     Activity[]
  portalComments PortalComment[]
  costs          Cost[]
  timeEntries    TimeEntry[]
  timerSessions  TimerSession[]

  @@index([agencyId])
  @@index([clientId])
  @@index([agencyId, status])
}

model Task {
  id         String   @id @default(cuid())
  agencyId   String
  projectId  String
  title      String
  isDone     Boolean  @default(false)
  sortOrder  Int      @default(0)
  assigneeId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  agency        Agency         @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee      User?          @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  timeEntries   TimeEntry[]
  timerSessions TimerSession[]

  @@index([projectId])
  @@index([agencyId])
  @@index([assigneeId])
}

model Invoice {
  id        String        @id @default(cuid())
  agencyId  String
  clientId  String
  number    String
  status    InvoiceStatus @default(unpaid)
  issueDate DateTime      @default(now())
  dueDate   DateTime?
  total     Decimal       @default(0) @db.Decimal(10, 2)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @default(now()) @updatedAt
  deletedAt DateTime?

  agency     Agency        @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  client     Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  items      InvoiceItem[]
  activities Activity[]

  @@unique([agencyId, number])
  @@index([agencyId])
  @@index([clientId])
  @@index([agencyId, status, dueDate])
}

model InvoiceItem {
  id          String   @id @default(cuid())
  agencyId    String
  invoiceId   String
  description String
  qty         Int      @default(1)
  unitPrice   Decimal  @default(0) @db.Decimal(10, 2)
  lineTotal   Decimal  @default(0) @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  agency  Agency  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([agencyId])
}

model Comment {
  id         String   @id @default(cuid())
  agencyId   String
  clientId   String
  projectId  String?
  authorName String
  body       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  agency  Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  client  Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([projectId])
  @@index([agencyId])
}

// F2 — pending team member invitations. Members always join with role=member;
// acceptance is wired through the Better Auth signup hook (matched by email).
model TeamInvite {
  id         String    @id @default(cuid())
  agencyId   String
  name       String
  email      String
  token      String    @unique @default(cuid())
  role       Role      @default(member)
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@index([agencyId])
  @@index([email])
}

// F5 — client-portal discussion threads, scoped to a project. Authored by the
// client (unauthenticated, identified by the portal token), so no user link.
model PortalComment {
  id        String   @id @default(cuid())
  agencyId  String
  projectId String
  author    String
  message   String
  createdAt DateTime @default(now())

  agency  Agency  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([agencyId])
}

// Automation Builder — trigger/condition/action workflows attached to the
// Activity event stream (see src/server/services/automation-engine.ts).
// triggerType matches an ActivityType string (src/server/activity.ts) or
// "MANUAL". conditions/actions are Json arrays so new trigger/action kinds —
// including future ERP modules and AI-generated workflows — register purely
// by catalog entry, with no schema change.
model Automation {
  id          String   @id @default(cuid())
  agencyId    String
  name        String
  description String?
  enabled     Boolean  @default(true)
  triggerType String
  conditions  Json?
  actions     Json
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  agency  Agency          @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  creator User?           @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  runs    AutomationRun[]

  @@index([agencyId, triggerType, enabled])
  @@index([agencyId, createdAt])
}

// One row per automation execution — success/failure + a per-step log,
// surfaced in the run-history table and the dashboard's recent-runs widget.
model AutomationRun {
  id           String    @id @default(cuid())
  automationId String
  status       String
  triggeredAt  DateTime  @default(now())
  completedAt  DateTime?
  logs         Json?
  activityId   String?

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId, triggeredAt])
}

// Finance Intelligence — a flat cost log, NOT double-entry bookkeeping (no
// accounts, no debits/credits, no journal entries). Lets Client/Project
// Profitability compute real profit/margin against Invoice revenue. A future
// ERP accounting module can point `category` at a real chart-of-accounts
// model via a new optional FK without breaking existing rows.
model Cost {
  id          String   @id @default(cuid())
  agencyId    String
  clientId    String?
  projectId   String?
  amount      Decimal  @db.Decimal(10, 2)
  category    String
  description String?
  incurredAt  DateTime @default(now())
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  agency  Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  client  Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator User?    @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([agencyId, incurredAt])
  @@index([clientId])
  @@index([projectId])
}

// ── Agency Operations Suite: Proposal Builder ────────────────────────────────
// Proposal → Client → Project → Invoice → Automation → Timeline. shareToken
// mirrors Client.portalToken exactly (unauthenticated, unguessable-URL access
// for the public /p/[shareToken] route).
model Proposal {
  id               String    @id @default(cuid())
  agencyId         String
  clientId         String?
  templateCategory String?
  name             String
  status           String    @default("draft") // draft|sent|viewed|accepted|rejected|expired|cancelled
  subtotal         Decimal   @default(0) @db.Decimal(10, 2)
  discountType     String? // "percent" | "flat"
  discountValue    Decimal?  @db.Decimal(10, 2)
  taxPercent       Decimal?  @db.Decimal(5, 2)
  total            Decimal   @default(0) @db.Decimal(10, 2)
  currency         String    @default("USD")
  validUntil       DateTime?
  terms            String?
  notes            String?
  shareToken       String    @unique @default(cuid())
  sentAt           DateTime?
  viewedAt         DateTime?
  acceptedByName   String?
  acceptedAt       DateTime?
  rejectedReason   String?
  rejectedAt       DateTime?
  createdBy        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  agency     Agency             @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  client     Client?            @relation(fields: [clientId], references: [id], onDelete: SetNull)
  creator    User?              @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  items      ProposalItem[]
  activities ProposalActivity[]

  @@index([agencyId, createdAt])
  @@index([agencyId, status])
  @@index([clientId])
}

model ProposalItem {
  id          String   @id @default(cuid())
  agencyId    String
  proposalId  String
  description String
  qty         Int      @default(1)
  unitPrice   Decimal  @default(0) @db.Decimal(10, 2)
  lineTotal   Decimal  @default(0) @db.Decimal(10, 2)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  agency   Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId])
  @@index([agencyId])
}

// Agency-saved custom templates ("Save as template"). The 8 built-in starter
// categories (Website Development, SEO, Marketing, ...) are a static code
// catalog (src/lib/proposal-templates.ts), not DB rows.
model ProposalTemplate {
  id           String   @id @default(cuid())
  agencyId     String
  name         String
  category     String?
  description  String?
  defaultItems Json // { description, qty, unitPrice }[]
  defaultTerms String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@index([agencyId])
}

// Proposal-specific granular log (e.g. every view, with metadata) —
// complements, doesn't replace, the single headline Activity row logged for
// the same event (same dual-log pattern as AutomationRun vs. the
// "Automation Succeeded" Activity entry).
model ProposalActivity {
  id         String   @id @default(cuid())
  agencyId   String
  proposalId String
  type       String // viewed|sent|accepted|rejected|commented|expired|cancelled
  metadata   Json?
  createdAt  DateTime @default(now())

  agency   Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId, createdAt])
}

// ── Agency Operations Suite: Recurring Billing ───────────────────────────────
model Subscription {
  id                 String   @id @default(cuid())
  agencyId           String
  clientId           String
  name               String
  amount             Decimal  @db.Decimal(10, 2)
  currency           String   @default("USD")
  frequency          String // WEEKLY|MONTHLY|QUARTERLY|YEARLY|CUSTOM
  customIntervalDays Int?
  nextBillingDate    DateTime
  status             String   @default("active") // active|paused|cancelled
  autoSend           Boolean  @default(true)
  autoRemind         Boolean  @default(true)
  description        String?
  createdBy          String?
  // Retry/backoff state for failed billing cycles (see recurring-billing.ts).
  // failureCount resets to 0 on any successful generation; consecutiveFailureCount
  // drives exponential backoff and auto-pause after too many attempts.
  consecutiveFailureCount Int       @default(0)
  lastFailureAt           DateTime?
  nextRetryAt             DateTime?
  autoPausedAt            DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  agency      Agency             @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  client      Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  creator     User?              @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  occurrences RecurringInvoice[]

  @@index([agencyId, status, nextBillingDate])
  @@index([clientId])
}

// One row per billing occurrence — scheduled, generated, failed, or skipped.
model RecurringInvoice {
  id             String    @id @default(cuid())
  agencyId       String
  subscriptionId String
  invoiceId      String?
  scheduledFor   DateTime
  generatedAt    DateTime?
  status         String    @default("scheduled") // scheduled|generated|failed|skipped
  failureReason  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  agency       Agency       @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  // DB-enforced idempotency: at most one occurrence row per subscription per
  // billing cycle, so parallel cron runs / manual "Generate Now" / retries
  // can never produce two invoices for the same cycle. See recurring-billing.ts.
  @@unique([subscriptionId, scheduledFor])
  @@index([agencyId])
}

// ── Agency Operations Suite: Time Tracking & Resource Management ────────────
model TimeEntry {
  id              String    @id @default(cuid())
  agencyId        String
  userId          String
  projectId       String
  clientId        String // denormalized from project.clientId for fast client-scoped queries
  taskId          String?
  description     String?
  startedAt       DateTime
  endedAt         DateTime?
  durationMinutes Int
  billable        Boolean   @default(true)
  billableRate    Decimal?  @db.Decimal(10, 2) // client rate, snapshotted at entry time
  costRate        Decimal?  @db.Decimal(10, 2) // User.hourlyCostRate, snapshotted at entry time
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  agency  Agency  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  task    Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([agencyId, startedAt])
  @@index([userId, startedAt])
  @@index([projectId])
  @@index([clientId])
}

// At most one active session (running|paused) per user, enforced at the app
// level in src/server/services/timer.ts. Stop converts the session into a
// TimeEntry and deletes this row.
model TimerSession {
  id                 String    @id @default(cuid())
  agencyId           String
  userId             String
  projectId          String
  taskId             String?
  description        String?
  startedAt          DateTime
  pausedAt           DateTime?
  accumulatedSeconds Int       @default(0)
  status             String    @default("running") // running|paused
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  agency  Agency  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task    Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  // DB-enforced guarantee: at most one running/paused timer per user, closing
  // the check-then-insert race window in startTimer(). See services/timer.ts.
  @@unique([agencyId, userId])
}

// ── Lead magnet: Agency Operations Scorecard + Profit Calculator ────────────
// Public, UNAUTHENTICATED funnel. These two models are intentionally isolated
// from the tenant graph (no relations into Agency/Client/etc.) so the open
// scorecard flow can never read or write authenticated workspace data. The only
// link back to a tenant is the nullable, relation-free `convertedAgencyId`
// string on ScorecardLead, used purely for conversion attribution.

// Operational maturity tiers — derived from the overall score. Scoring weights
// and thresholds live in src/config/scorecard.ts (single source of truth).
enum MaturityLevel {
  FIREFIGHTING // 0–39   — running the agency from the inbox
  STITCHED // 40–59  — tools exist but don't talk
  COORDINATED // 60–79  — solid foundation
  OPERATING_SYSTEM // 80–100 — a tight, scalable operation
}

// One assessment attempt. Created anonymously on first answer (keyed by a
// first-party cookie UUID for resume + abandon analysis), then enriched with
// computed results on completion. `answers`/`calibration` are JSON blobs of
// option ids validated against the config — never free text.
model ScorecardSession {
  id          String @id @default(cuid())
  // First-party cookie UUID. Lets a visitor resume on refresh/return and lets us
  // measure abandonment. Not PII.
  anonId      String
  answers     Json   @default("{}") // { [questionId]: optionId }
  calibration Json   @default("{}") // { teamSize, revenueBand, billableRate? }

  // Computed snapshot (null until completed). Stored so results/report pages and
  // the email render identically without recomputation.
  overallScore    Int?
  pillarScores    Json? // { A: number, B: number, C: number, D: number }
  maturity        MaturityLevel?
  revenueLeakYear Int? // estimated annual revenue leakage (currency minor unit = whole units)
  timeLostHours   Float? // estimated hours lost per week
  recommendations Json? // RecommendationResult[] snapshot

  completedAt DateTime?
  lead        ScorecardLead?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([anonId])
  @@index([completedAt])
}

// Captured lead — created when a visitor unlocks the full report with their
// email. One-to-one with the session that produced it.
model ScorecardLead {
  id             String  @id @default(cuid())
  email          String
  marketingOptIn Boolean @default(false)

  sessionId String           @unique
  session   ScorecardSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // Hosted HTML report (print-to-PDF). Null until generated/persisted.
  reportUrl String?

  // Conversion attribution. Relation-free on purpose (see block comment above):
  // set to an Agency id when this lead later starts a Sarion trial.
  convertedAgencyId String?
  convertedAt       DateTime?

  // Marketing attribution captured from the landing URL.
  utmSource   String?
  utmMedium   String?
  utmCampaign String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([convertedAgencyId])
}
